# GLOBAL
max-history=100
sort=-time

# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
#on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# STYLE OPTIONS
font=JetBrainsMono NF 13
width=300
height=110
margin=10
padding=10
border-size=1
border-radius=6
icons=1
max-icon-size=64
icon-location=left
markup=1
actions=1
history=1
text-alignment=left
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right

# Recolored to the neutral grayscale used by waybar/kitty/wofi (was
# leftover Catppuccin lavender/blue/pink that didn't match the system).
# Text stays fully opaque for legibility; only the backdrop is glassy --
# the compositor's blur (see hyprland.conf layerrule) does the rest.
background-color=#1e1e1ea6
text-color=#d8d8d8
border-color=#d8d8d826
progress-color=over #c8c8c8

[urgency=low]
border-color=#d8d8d81a
default-timeout=2000

[urgency=normal]
border-color=#d8d8d826
default-timeout=5000

[urgency=high]
border-color=#c98a8a
text-color=#c98a8a
default-timeout=0

[category=mpd]
border-color=#c2ba9d
default-timeout=2000
group-by=category
