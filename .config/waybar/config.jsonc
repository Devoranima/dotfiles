{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 50,
    "modules-left": ["hyprland/workspaces","cpu","memory","disk","battery","hyprland/window"],
    "modules-center": ["custom/wallpaper", "custom/kblayout", "custom/updates", "clock","custom/power_btn"],
    "modules-right": ["custom/weather", "bluetooth", "network", "pulseaudio","pulseaudio#microphone"],
    
    "hyprland/window": {
        "format": "{}",
        "max-length": 33
    },

    "custom/launch_wofi": {
        "format": "",
        "on-click": "pkill wofi; wofi -n",
        "tooltip": false
    },

    "custom/lock_screen": {
        "format": "",
        "on-click": "sh -c '(sleep 0.5s; swaylock)' & disown",
        "tooltip": false
    },

    "custom/wallpaper": {
        "format": "󰐾",
        "on-click": "~/.config/waybar/scripts/wallpaper-picker.sh",
        "tooltip": false
    },
    
    "custom/kblayout": {
        "format": "  {}",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/kblayout.sh"
    },

    "hyprland/language": {
	    "format": "{short}",
	    "keyboard-name": "8bitdo-8bitdo-retro-keyboard-receiver-keyboard"
    },

    "custom/power_btn": {
        "format": " ",
        "on-click": "sh -c '(sleep 0.5s; wlogout --protocol layer-shell)' & disown",
        "tooltip": false
    },

    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "max-length": 10,
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "tooltip-format": "HDD - {used} used out of {total} on {path} ({percentage_used}%)",
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    },

    "memory": {
        "interval": 30,
        "format": " {}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "Memory - {used:0.1f}GB used",
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    },
    "battery": {
	    "format": "{icon} {capacity}%",
    	"format-charging": "󰂄 {capacity}%",
    	"format-plugged": "󰚥 {capacity}%",
    	"format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    	"tooltip": true,
    	"tooltip-format": "{timeTo}, {capacity}%",
    	"interval": 30,
        "on-click": "~/.config/waybar/scripts/powerprofile.sh"
    },
    "custom/updates": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/update-sys",
        "on-click": "~/.config/waybar/scripts/update-sys update",
        "interval": 300,
        "tooltip": true
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": []
        }
    },

    "custom/weather": {
        //shows the current weather and forecast
        "tooltip" : true,
        "format" : "{}",
        "interval" : 300,
        "exec" : "~/.config/waybar/scripts/waybar-wttr.py",
        "return-type" : "json"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "{controller_alias}\t{controller_address}\nStatus: {status}",
        "tooltip-format-disabled": "Bluetooth disabled",
        "tooltip-format-off": "Bluetooth off",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\nConnected devices ({num_connections}):\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "bluetooth toggle",
        "on-click-right": "blueman-manager",
        "interval": 5
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  No Connection",
        "format-linked": "󰈀  {ifname} (No IP)",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{icon}  {essid}\nSignal: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": "󰈀  {ifname}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty --title nmtui sh -c 'nmtui'",
        "interval": 5
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip": true,
        "tooltip-format": " {:%A, %B %e %Y}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        }
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-click": "pamixer --default-source -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5",
        "scroll-step": 5
    }
}
